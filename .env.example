# AlertTriage v2 — Environment Variables
# Copy to .env and fill in your secrets. Never commit .env to version control.

# ── Anthropic (Claude) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (GPT) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Global Overrides ──────────────────────────────────────────────────────
ALERTTRIAGE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
ALERTTRIAGE_JSON_LOGS=false         # true for production log pipelines
ALERTTRIAGE_DATA_DIR=data
ALERTTRIAGE_REPORTS_DIR=reports
ALERTTRIAGE_ANONYMIZE_SALT=         # Set a long random string in production!

# ── Per-client SIEM Credentials ───────────────────────────────────────────
# Pattern: ALERTTRIAGE_<CLIENT_ID_UPPERCASE>_API_KEY
# Example for client_id=acme-corp:
ALERTTRIAGE_ACME_CORP_API_KEY=

# Add one line per client:
# ALERTTRIAGE_GLOBEX_API_KEY=
# ALERTTRIAGE_INITECH_API_KEY=
